# Telegram API credentials — get these at https://my.telegram.org
# Copy this file to `.env` and fill in your values. `.env` is gitignored.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Your phone number with country code, e.g. +34612345678 for Spain
TELEGRAM_PHONE=

# Optional: cloud password for 2FA. Leave empty if you don't have 2FA enabled.
# TELEGRAM_2FA_PASSWORD=
