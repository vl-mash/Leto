# Leto repo holds orchestration code, conventions, schedulers, integrations, and the index.
# Data lives in the vault and Claude Code memory — never in this repo.
# These ignores are belt-and-suspenders against accidental data ingestion.

# OS
.DS_Store
Thumbs.db
*.swp
*~

# Editor
.vscode/
.idea/

# Vault paths (never copy in)
**/Vladimir's Vault/
**/Obsidian Vault/

# Memory paths (never copy in)
**/.claude/projects/

# Local secrets / credentials
.env
.env.local
*.key
*.pem
secrets/
credentials/

# Local-only data outputs (Telegram exports, intermediate artifacts)
.local-data/

# Telethon / Telegram session files
*.session
*.session-journal

# Python venvs
venv/
.venv/
__pycache__/
*.pyc

# Temporary
*.tmp
.cache/
