# Leto secrets — template. Every credential Leto uses, in one place.
#
# Real file lives at ~/.config/leto/leto.env (mode 600), NOT in this repo.
# It sits outside every git work tree on purpose: the EOD scheduler is an
# autonomous agent with git access here, and .gitignore is one `git add -f`
# away from useless. This template is committed; the real file never is.
#
# Create it from the legacy single-value files with:
#   bash ~/Projects/Leto/scripts/migrate-secrets.sh
#
# Verify every key actually authenticates (not just "file exists"):
#   python3 ~/Projects/Leto/hooks/leto_secrets.py --check
#
# Resolution order per key: environment variable → leto.env → legacy
# ~/.config/leto/<name> file. Legacy files keep working until you delete them.

# ── Linear ───────────────────────────────────────────────────────────────────
# Personal API key. Linear → Settings → Security & access → New API key.
# Used by: integrations/linear/linear-graphql.sh (morning brief, EOD, weekly).
# Rotate here and nowhere else — this is the single point of truth.
export LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Slack ────────────────────────────────────────────────────────────────────
# Bot token (xoxb-). api.slack.com/apps → OAuth & Permissions → Bot User Token.
# Used by: integrations/slack/leto-bot-post.sh (every scheduler's DM channel).
export SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# App-level token (xapp-). Same app → Basic Information → App-Level Tokens,
# scope connections:write. Socket Mode only; the listener needs it.
export SLACK_APP_TOKEN=xapp-1-Axxxxxxxxxx-xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxx

# User OAuth token (xoxp-). Needed to read DMs the bot is not a member of —
# `/leto draft` and the weekly thread read depend on it. Optional.
export SLACK_USER_TOKEN=xoxp-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxx

# ── YouTrack ─────────────────────────────────────────────────────────────────
# Permanent token. YouTrack → Profile → Account Security → New token.
# Used by: integrations/youtrack/digest.sh (weekday 11:00 digest).
# Previously lived in a SECOND .env under
# ~/.claude/scheduled-tasks/youtrack-daily-digest/ — folded in here.
export YOUTRACK_BASE_URL=https://your-instance.youtrack.cloud
export YOUTRACK_TOKEN=perm:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Not secrets, deliberately left alone ─────────────────────────────────────
# ~/.config/leto/cost-cap.json        spend caps (plain config)
# ~/.config/leto/schedulers-paused    global kill switch (flag file, rm to resume)
